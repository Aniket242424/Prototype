# ============================================================
# Trading_Agent — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
APP_ENV=development                    # development | staging | production
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
APP_TIMEZONE=Asia/Kolkata

# --- Live-trading 3-lock gate ---
# This is lock #1. Locks #2 (ACKNOWLEDGMENT.md present) and #3 (SHA recorded
# in acknowledgment_log table) are checked at runtime. All three must pass.
LIVE_TRADING=false

# --- Capital configuration ---
# All risk caps in config/risk.yaml are expressed as % of this number.
TRADING_CAPITAL_INR=100000

# --- Upstox API ---
# https://upstox.com/developer/api-documentation/
UPSTOX_API_KEY=replace_me
UPSTOX_API_SECRET=replace_me
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_BASE_URL=https://api.upstox.com/v2
# WebSocket endpoint migrated to v3 — v2 returns 410 Gone (verified 2026-05-09).
UPSTOX_WS_URL=wss://api.upstox.com/v3/feed/market-data-feed

# --- Anthropic (Claude advisor) ---
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-opus-4-7

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_agent
POSTGRES_USER=trading_agent
POSTGRES_PASSWORD=change_me_strong_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Token storage encryption ---
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_me_with_fernet_key

# --- Alerts (optional, Phase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
